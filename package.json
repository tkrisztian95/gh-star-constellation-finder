{
  "name": "gh-star-constellation-finder",
  "version": "0.1.0",
  "description": "AI-powered TUI to organize GitHub stars into native lists.",
  "type": "module",
  "license": "MIT",
  "author": "Krisztian Toth <ktothdev@gmail.com>",
  "homepage": "https://github.com/tkrisztian95/gh-star-constellation-finder#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkrisztian95/gh-star-constellation-finder.git"
  },
  "bugs": {
    "url": "https://github.com/tkrisztian95/gh-star-constellation-finder/issues"
  },
  "keywords": [
    "github",
    "stars",
    "tui",
    "bun",
    "ink",
    "ai",
    "openai",
    "ollama",
    "cli",
    "developer-tools"
  ],
  "scripts": {
    "build": "bun build src/index.tsx --target=bun",
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "bun run src/__tests__/*.test.ts"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  },
  "dependencies": {
    "@octokit/graphql": "^8.2.2",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "langfuse": "^3.38.20",
    "openai": "^4.104.0",
    "posthog-node": "^5.34.2",
    "react": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.28",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
