{
  "name": "gh-star-constellation-finder",
  "version": "1.0.0",
  "description": "AI-powered TUI to organize GitHub stars into native lists.",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.tsx",
    "dev": "bun run src/index.tsx",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@octokit/graphql": "^8.1.0",
    "ink": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "langfuse": "^3.38.6",
    "openai": "^4.0.0",
    "posthog-node": "^5.28.8",
    "react": "^18.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.0.0"
  }
}
