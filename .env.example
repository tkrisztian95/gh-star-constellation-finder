# Required: GitHub Personal Access Token with read:user scope (and write scope for List mutations)
GITHUB_TOKEN=your_github_pat_here

# AI backend — set one of the following:
# Option A: OpenAI (comment out or remove to use Ollama instead)
OPENAI_API_KEY=your_openai_key_here

# Option B: Ollama (comment out OPENAI_API_KEY above to auto-detect Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional: Langfuse prompt tracing (leave unset to disable)
# Sign up at https://cloud.langfuse.com or run locally with Docker (see README)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=http://localhost:3000  # uncomment for self-hosted
